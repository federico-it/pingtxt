# syntax=docker/dockerfile:1
# pingtxt agent: a ~10 MB probe that connects out to the hub.

# Keep in sync with the "go" line of go.mod (CI checks it).
ARG GO_VERSION=1.26.10

FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-alpine AS go
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
ARG VERSION=dev
ARG TARGETOS TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -buildvcs=false -ldflags "-s -w -X main.version=$VERSION" -o /out/pingtxt-agent ./cmd/pingtxt-agent

FROM alpine:3.22
# The agent runs as user pingtxt (uid 10001) with only CAP_NET_RAW, see
# docker/entrypoint.sh.
RUN apk add --no-cache ca-certificates tzdata setpriv \
 && addgroup -S -g 10001 pingtxt \
 && adduser -S -D -H -u 10001 -G pingtxt -h /data -s /sbin/nologin pingtxt
COPY --from=go /out/pingtxt-agent /usr/local/bin/pingtxt-agent
# Self-updates go to the /data volume (the image's own binary is replaced
# with the next image) and run from there until a new image is pulled.
ENV PINGTXT_CONTAINER=1 PINGTXT_UPDATE_DIR=/data
VOLUME /data
COPY docker/entrypoint.sh /usr/local/bin/docker-entrypoint
ENTRYPOINT ["docker-entrypoint", "pingtxt-agent"]
