# syntax=docker/dockerfile:1
# pingtxt agent: a ~10 MB probe that connects out to the hub.

FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS go
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
ARG VERSION=dev
ARG TARGETOS TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags "-s -w -X main.version=$VERSION" -o /out/pingtxt-agent ./cmd/pingtxt-agent

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata
COPY --from=go /out/pingtxt-agent /usr/local/bin/pingtxt-agent
ENTRYPOINT ["pingtxt-agent"]
